{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/main.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ],
  "functions": {
    "backend/main.py": {
      "excludeFiles": "{frontend/**,artifacts-download/**,Skins/**,chatgpt/**,jesseguide/**,.agents/**,.paul/**,buildguide/**,hyperliquid-skills/**,hyperliquid-stats-web/**,knowledge-work-plugins/**,senpi-skills/**,**/*.srt,**/*.pdf,**/*.png,**/test_*.py,**/*_test.py,**/__pycache__/**}"
    }
  }
}
